# Copie para .env e ajuste os valores:
#   cp .env.example .env
#
# O .env NAO deve ser versionado. Ele contem credenciais e o segredo do JWT.

# --- Banco de dados ---
DB_NAME=rhsoft
DB_USER=rhsoft
DB_PASSWORD=troque-esta-senha-do-banco
DB_ROOT_PASSWORD=troque-esta-senha-de-root

# --- Segredo do JWT ---
# Gere um valor forte e aleatorio. Qualquer mudanca aqui invalida os tokens
# ja emitidos (usuarios precisam logar de novo).
#
# Para gerar um:
#   openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
